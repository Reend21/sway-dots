{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "color": { "1": "yellow" },
    "padding": { "right": 4 }
  },

  "display": {
    "separator": " "
  },

  "modules": [
    {
      "type": "custom",
      "format": "\u001b[33m\u001b[9m⓵ Vernita Green\u001b[0m"
    },
    {
      "type": "custom",
      "format": "   \u001b[33m\u001b[9mCopperhead\u001b[0m"
    },

    { "type": "break" },

    {
      "type": "custom",
      "format": "\u001b[33m\u001b[9m⓶ O-Ren Ishii\u001b[0m"
    },
    {
      "type": "custom",
      "format": "   \u001b[33m\u001b[9mCottonmouth\u001b[0m"
    },

    { "type": "break" },

    {
      "type": "custom",
      "format": "\u001b[33m\u001b[9m⓷ Budd\u001b[0m"
    },
    {
      "type": "custom",
      "format": "   \u001b[33m\u001b[9mSidewinder\u001b[0m"
    },

    { "type": "break" },

    {
      "type": "custom",
      "format": "\u001b[33m\u001b[9m⓸ Elle Driver\u001b[0m"
    },
    {
      "type": "custom",
      "format": "   \u001b[33m\u001b[9mCalifornia Mountain Snake\u001b[0m"
    },

    { "type": "break" },

    {
      "type": "custom",
      "format": "\u001b[38;2;214;26;31m⓹ BILL\u001b[0m"
    },
    {
      "type": "custom",
      "format": "   \u001b[38;2;214;26;31mSnake Charmers\u001b[0m"
    },

    { "type": "break" },
    { "type": "break" },

    {
      "type": "os",
      "key": "",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "󰏖",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "",
      "keyColor": "yellow"
    }
  ]
}
