{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 8,

    "modules-left": [
        "custom/launcher",
        "sway/workspaces",
        "sway/mode"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "temperature",
        "battery",
        "tray",
        "custom/power"
    ],

    "custom/launcher": {
        "format": "花嫁",
        "tooltip": false,
        "on-click": "fuzzel"
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
	    "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十",
        }
    },

    "clock": {
        "format": "  {:%H:%M}",
        "tooltip-format": "<big>{:%Y %B %d}</big>\n<tt>{calendar}</tt>",
        "interval": 1
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "tooltip": true
    },

    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip": true
    },

    "cpu": {
        "format": ""
    },

    "memory": {
        "format": "󰍛"
    },

    "temperature": {
        "critical-threshold": 80,
        "format": ""
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },

    "tray": {
        "spacing": 10
    },

"custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.config/fuzzel/powermenu.sh"
}
}
