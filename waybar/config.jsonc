{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 8,

    "modules-left": [
        "custom/launcher",
        "sway/workspaces",
        "sway/mode",
        "custom/screenshot",
        "custom/clipboard"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/media",
        "pulseaudio",
        "memory",
        "battery",
        "tray",
        "custom/power"
    ],

    "custom/launcher": {
        "format": "menu",
        "tooltip": false,
        "on-click": "fuzzel"
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
	        "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十"
        }
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%Y %B %d}</big>\n<tt>{calendar}</tt>",
        "interval": 1,
        "on-click": "kitty --class calcure -e calcure"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "tooltip": true
    },

    "memory": {
        "format": "󰍛  {percentage}%",
        "states": {
            "warning": 50,
            "critical": 85
        }
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },

    "tray": {
        "spacing": 10
    },

"custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.config/fuzzel/powermenu.sh"
},

"custom/screenshot": {
    "format": "󰹑",
    "tooltip": true,
    "tooltip-format": "Ekran Alıntısı",
    "on-click": "grim -g \"$(slurp)\" - | swappy -f -"
},

"custom/clipboard": {
    "format": "󰅍",
    "tooltip": true,
    "tooltip-format": "Pano Yöneticisi (Clipse)",
    "on-click": "kitty --class clipse -e clipse"
},

"custom/media": {
    "format": "{}",
    "return-type": "",
    "max-length": 40,
    "exec": "playerctl metadata --format '󰎈  {{ artist }} — {{ title }}' 2>/dev/null || echo ''",
    "exec-if": "playerctl status 2>/dev/null | grep -q Playing",
    "interval": 3,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": true,
    "tooltip-format": "Media Player Controls"
}
}
